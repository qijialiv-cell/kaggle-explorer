# Copy this file to .streamlit/secrets.toml and fill in ONE of the credential options.
# secrets.toml is git-ignored — never commit real credentials.

# Option A (new-style token from https://www.kaggle.com/settings/api → "Generate New Token")
# kaggle_api_token = "KGAT_xxxxxxxxxxxxxxxxxxxx"

# Option B (legacy kaggle.json values)
# kaggle_username = "your-kaggle-username"
# kaggle_key = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Required: login whitelist + shared access code
allowed_emails = ["name1@hct.ac.ae", "name2@hct.ac.ae"]
access_code = "choose-a-code"

# Optional: protect the Admin page (refresh) with a shared password.
# admin_password = "change-me"

# Optional: store the SQLite file somewhere else (e.g. outside a synced OneDrive folder).
# db_path = "C:/kaggle-explorer-data/datasets.db"

# Optional: a shared Gemini key for everyone. Leave out to let each person paste their own key
# on the Analyze page (kept only in their browser session).
# gemini_api_key = "AIza..."
